# Copy this file to .env.local and fill in the values.

# Required — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=
ADMIN_EMAIL=

# Optional — Paystack (card + M-Pesa checkout). When unset, store checkout and
# donations fall back to a "pending, we'll contact you" flow with no online
# payment — the site works fine either way. Set this to turn on real payment
# collection. Also register this webhook URL in the Paystack dashboard:
#   https://kiamburoad.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
